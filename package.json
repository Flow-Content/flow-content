{
  "name": "Flow-Content",
  "private": true,
  "version": "3.10.2",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Flow Content — AI Script Writing Tool Desktop",
  "author": "Your Name",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env BROWSER=none DEV_SERVER_PORT=3200 npm run dev\" \"wait-on http://localhost:3200 && cross-env DEV_SERVER_PORT=3200 electron .\"",
    "electron:build": "node scripts/prepare-electron-env.cjs && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -w",
    "electron:publish": "node scripts/prepare-electron-env.cjs && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -w --publish always"
  },
  "dependencies": {
    "@google/genai": "^1.26.0",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "express": "^4.22.2",
    "googleapis": "^144.0.0",
    "https-proxy-agent": "^7.0.6",
    "jszip": "^3.10.1",
    "mongoose": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^25.7.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.flowcontent.app",
    "productName": "Flow Content",
    "forceCodeSigning": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Flow-Content",
        "repo": "flow-content",
        "private": true
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Flow-Content-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "build-env/update-token.txt",
        "to": "update-token.txt"
      },
      {
        "from": "build-env/.env",
        "to": ".env"
      },
      {
        "from": "build-env/vertex-credentials.json",
        "to": "vertex-credentials.json"
      }
    ]
  }
}
